<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ReportVarietyEditor</class>
 <widget class="QDialog" name="ReportVarietyEditor">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>700</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Report Variety Editor</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="infoLabel">
     <property name="text">
      <string/>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="reportLabel">
       <property name="text">
        <string>Target Report:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <layout class="QHBoxLayout" name="reportLayout">
       <item>
        <widget class="QLineEdit" name="reportNameEdit">
         <property name="placeholderText">
          <string>Enter report name (new or existing)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="selectReportButton">
         <property name="text">
          <string>Select...</string>
         </property>
         <property name="toolTip">
          <string>Select from existing custom reports</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="varietyLabel">
       <property name="text">
        <string>Variety Name:</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QLineEdit" name="varietyNameEdit">
       <property name="placeholderText">
        <string>e.g., Days, Weeks, Monthly Summary</string>
       </property>
       <property name="maxLength">
        <number>50</number>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="descriptionLabel">
       <property name="text">
        <string>Description:</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QLineEdit" name="descriptionEdit">
       <property name="placeholderText">
        <string>Optional description</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="queryGroupBox">
     <property name="title">
      <string>SQL Query</string>
     </property>
     <layout class="QVBoxLayout" name="queryLayout">
      <item>
       <widget class="QPlainTextEdit" name="queryEdit">
        <property name="font">
         <font>
          <family>Courier New</family>
          <pointsize>9</pointsize>
         </font>
        </property>
        <property name="placeholderText">
         <string>Enter SQL query with macros:
#PROFILE_ID - Current profile ID
#START_DATE - Report start date
#END_DATE - Report end date</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="macroHelpLabel">
        <property name="text">
         <string>Available Macros: #PROFILE_ID, #START_DATE, #END_DATE</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="font">
         <font>
          <pointsize>8</pointsize>
          <italic>true</italic>
         </font>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::NoButton</set>
     </property>
     <layout class="QHBoxLayout" name="buttonBoxLayout">
      <item>
       <widget class="QPushButton" name="testQueryButton">
        <property name="text">
         <string>Test Query</string>
        </property>
        <property name="toolTip">
         <string>Test query with sample data (last 30 days)</string>
        </property>
        <property name="icon">
         <iconset resource="Resources.qrc">
          <normaloff>:/icons/play.png</normaloff>:/icons/play.png</iconset>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="saveButton">
        <property name="text">
         <string>Save</string>
        </property>
        <property name="icon">
         <iconset resource="Resources.qrc">
          <normaloff>:/icons/save.png</normaloff>:/icons/save.png</iconset>
        </property>
        <property name="default">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="cancelButton">
        <property name="text">
         <string>Cancel</string>
        </property>
        <property name="icon">
         <iconset resource="Resources.qrc">
          <normaloff>:/icons/cancel.png</normaloff>:/icons/cancel.png</iconset>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources>
  <include location="Resources.qrc"/>
