     <property name="styleSheet">
      <string notr="true">border: 1px solid; border-radius: 6px; padding: 6px;</string>
     </property>
     <property name="text">
      <string>Prepare a copy of your OSCAR data to share with another user for review. The resulting .oscar file can be shared via a cloud storage link or any file transfer method.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <!-- Profile selection row -->
