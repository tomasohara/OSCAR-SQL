<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DeviceTimeCorrectionDialog</class>
 <widget class="QDialog" name="DeviceTimeCorrectionDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>820</width><height>640</height></rect>
  </property>
  <property name="windowTitle">
   <string>Time Corrections</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>6</number></property>
   <property name="margin"><number>8</number></property>

   <!-- Outer vertical splitter: top controls | bottom history -->
   <item>
    <widget class="QSplitter" name="verticalSplitter">
     <property name="orientation"><enum>Qt::Vertical</enum></property>

     <!-- TOP: horizontal splitter (device sidebar | correction controls) -->
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>

      <!-- Left: Device sidebar — wider default, resizable via splitter handle -->
      <widget class="QTreeWidget" name="deviceSidebar">
       <property name="minimumSize"><size><width>200</width><height>0</height></size></property>
       <property name="maximumSize"><size><width>400</width><height>16777215</height></size></property>
       <property name="headerHidden"><bool>true</bool></property>
       <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAsNeeded</enum></property>
       <column><property name="text"><string>Device</string></property></column>
      </widget>

      <!-- Right: Correction controls — top-to-bottom zone flow -->
      <widget class="QWidget" name="rightPanel">
       <layout class="QVBoxLayout" name="rightLayout">
        <property name="margin"><number>4</number></property>

        <!-- Header: device name, active date, mode, correction type -->
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QLabel" name="deviceNameLabel">
            <property name="text"><string>—</string></property>
            <property name="font"><font><bold>true</bold><pointsize>11</pointsize></font></property>
            <property name="minimumSize"><size><width>0</width><height>28</height></size></property>
           </widget>
          </item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
          <item><widget class="QLabel"><property name="text"><string>Active date:</string></property></widget></item>
          <item>
           <widget class="QLabel" name="activeDateLabel">
            <property name="text"><string>—</string></property>
            <property name="font"><font><bold>true</bold></font></property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QLabel" name="modeLabel">
          <property name="text"><string>New correction</string></property>
          <property name="minimumSize"><size><width>0</width><height>20</height></size></property>
         </widget>
        </item>

        <item>
         <layout class="QFormLayout">
          <item row="0" column="0">
           <widget class="QLabel"><property name="text"><string>Type:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="correctionTypeCombo">
            <item><property name="text"><string>Offset</string></property></item>
            <item><property name="text"><string>Travel</string></property></item>
            <item><property name="text"><string>DST Change</string></property></item>
            <item><property name="text"><string>Device Timezone Misconfiguration</string></property></item>
            <item><property name="text"><string>Device Reset</string></property></item>
           </widget>
          </item>
         </layout>
        </item>

        <!-- Zones side by side below the type selector -->
        <item>
         <layout class="QHBoxLayout" name="zonesLayout">

        <!-- Zone 1: Date Range -->
        <item>
         <widget class="QGroupBox" name="advancedGroup">
          <property name="title"><string>Date Range</string></property>
          <property name="checkable"><bool>true</bool></property>
          <property name="checked"><bool>false</bool></property>
          <layout class="QVBoxLayout">
           <item>
            <layout class="QHBoxLayout">
             <item><widget class="QLabel"><property name="text"><string>Start:</string></property></widget></item>
             <item>
              <widget class="QDateEdit" name="advStartDate">
               <property name="calendarPopup"><bool>false</bool></property>
               <property name="displayFormat"><string>yyyy-MM-dd</string></property>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            </layout>
           </item>
           <item>
            <layout class="QHBoxLayout">
             <item><widget class="QLabel"><property name="text"><string>End:</string></property></widget></item>
             <item>
              <widget class="QDateEdit" name="advEndDate">
               <property name="calendarPopup"><bool>false</bool></property>
               <property name="displayFormat"><string>yyyy-MM-dd</string></property>
              </widget>
             </item>
             <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
            </layout>
           </item>
           <item>
            <widget class="QCheckBox" name="advEndDateCheck">
             <property name="text"><string>No end</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- Zone 3: Time Offset Adjuster -->
        <item>
         <widget class="QGroupBox" name="offsetGroup">
          <property name="title"><string>Time Offset</string></property>
          <!-- Single grid: H/M/S rows + spanning rows share identical width -->
          <layout class="QHBoxLayout">
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           <item>
            <layout class="QGridLayout" name="offsetSpinnerGrid">
             <!-- Row 0: Hours -->
             <item row="0" column="0">
              <widget class="QPushButton" name="btnMinusHour">
               <property name="text"><string>&lt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLabel">
               <property name="text"><string>H</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="minimumSize"><size><width>24</width><height>0</height></size></property>
              </widget>
             </item>
             <item row="0" column="2">
              <widget class="QPushButton" name="btnPlusHour">
               <property name="text"><string>&gt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <!-- Row 1: Minutes -->
             <item row="1" column="0">
              <widget class="QPushButton" name="btnMinusMin">
               <property name="text"><string>&lt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLabel">
               <property name="text"><string>M</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="minimumSize"><size><width>24</width><height>0</height></size></property>
              </widget>
             </item>
             <item row="1" column="2">
              <widget class="QPushButton" name="btnPlusMin">
               <property name="text"><string>&gt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <!-- Row 2: Seconds -->
             <item row="2" column="0">
              <widget class="QPushButton" name="btnMinusSec">
               <property name="text"><string>&lt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLabel">
               <property name="text"><string>S</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="minimumSize"><size><width>24</width><height>0</height></size></property>
              </widget>
             </item>
             <item row="2" column="2">
              <widget class="QPushButton" name="btnPlusSec">
               <property name="text"><string>&gt;</string></property>
               <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              </widget>
             </item>
             <!-- Row 3: HH:MM:SS display — spans all three columns -->
             <item row="3" column="0" colspan="3">
              <widget class="QLabel" name="currentOffsetValue">
               <property name="text"><string>+0:00:00</string></property>
               <property name="font"><font><bold>true</bold><pointsize>14</pointsize></font></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>
             <!-- Row 4: Apply Last Offset — spans all three columns -->
             <item row="4" column="0" colspan="3">
              <widget class="QPushButton" name="btnApplyLastNight">
               <property name="text"><string>Apply Last Offset</string></property>
              </widget>
             </item>
             <!-- Row 5: Reset to Zero — spans all three columns -->
             <item row="5" column="0" colspan="3">
              <widget class="QPushButton" name="btnResetToZero">
               <property name="text"><string>Reset to Zero</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
          </layout>
         </widget>
        </item>

        </layout><!-- end zonesLayout -->
        </item>

        <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>

       </layout>
      </widget>
     </widget><!-- end mainSplitter -->

     <!-- BOTTOM: History panel — full width -->
     <widget class="QWidget" name="historyPanel">
      <layout class="QVBoxLayout" name="historyLayout">
       <property name="margin"><number>4</number></property>

       <!-- Toolbar: action buttons above the corrections table -->
       <item>
        <layout class="QHBoxLayout" name="correctionToolbar">
         <item>
          <widget class="QPushButton" name="btnNewCorrection">
           <property name="text"><string>New Correction</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnSaveCorrection">
           <property name="text"><string>Save Correction</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnDiscardChanges">
           <property name="text"><string>Discard Changes</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnDeleteRow">
           <property name="text"><string>Delete Correction</string></property>
          </widget>
         </item>
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
        </layout>
       </item>

       <item>
        <widget class="QLabel" name="historyLabel">
         <property name="text"><string>Active corrections for this date:</string></property>
        </widget>
       </item>
       <item>
        <widget class="QTableWidget" name="historyTable">
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <column><property name="text"><string>Device</string></property></column>
         <column><property name="text"><string>Date Range</string></property></column>
         <column><property name="text"><string>Type</string></property></column>
         <column><property name="text"><string>Offset</string></property></column>
         <column><property name="text"><string>Added</string></property></column>
        </widget>
       </item>
      </layout>
     </widget>

    </widget><!-- end verticalSplitter -->
   </item>

   <!-- Status bar: warnings and hints, full width, above Close button -->
   <item>
    <widget class="QLabel" name="largeDriftWarning">
     <property name="text"><string></string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="styleSheet"><string>color: #cc6600;</string></property>
     <property name="minimumSize"><size><width>0</width><height>20</height></size></property>
    </widget>
   </item>

   <!-- Close button -->
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><set>QDialogButtonBox::Close</set></property>
    </widget>
   </item>

  </layout>
 </widget>
