      </number>
      <number name="SessionEnd2_Month" id="827" type="integer" length="1" signed="no" display="decimal">
        <description>Session end (copy 2): month</description>
      </number>
      <number name="SessionEnd2_Day" id="828" type="integer" length="1" signed="no" display="decimal">
        <description>Session end (copy 2): day</description>
      </number>
      <number name="SessionEnd2_Hour" id="829" type="integer" length="1" signed="no" display="decimal">
        <description>Session end (copy 2): hour</description>
      </number>
      <number name="SessionEnd2_Minute" id="830" type="integer" length="1" signed="no" display="decimal">
        <description>Session end (copy 2): minute</description>
      </number>
      <number name="SessionEnd2_Second" id="831" type="integer" length="1" signed="no" display="decimal">
        <description>Session end (copy 2): second</description>
      </number>
      <binary name="Padding_0x42" id="832" length="2">
        <description>Padding (zeros)</description>
      </binary>

      <!-- 0x44: Misc fields -->
      <number name="Unknown_0x44" id="833" type="integer" length="2" endian="little" signed="no" display="decimal">
        <description>Unknown (observed: 217)</description>
      </number>
      <number name="Unknown_0x46" id="834" type="integer" length="2" endian="little" signed="no" display="decimal">
        <description>Unknown (observed: 123)</description>
      </number>
      <number name="MachineID_Hash" id="835" type="integer" length="4" endian="little" signed="no" display="hex">
        <description>Machine ID / hash (e.g. 0x2FF64C75)</description>
      </number>
      <number name="BlockRefCounter" id="836" type="integer" length="4" endian="little" signed="no" display="decimal">
        <description>Block reference counter (matches BlockSequenceIndex)</description>
      </number>
      <binary name="Padding_0x50" id="837" length="174">
        <description>Padding to end (zeros, 0x50–0xFD)</description>
      </binary>
      <number name="Checksum" id="838" type="integer" length="2" endian="little" signed="no" display="hex">
        <description>Block checksum (16-bit; observed: 0x0AB0)</description>
      </number>

    </structure><!-- UH_Record -->

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!--  UP RECORD  +0x480 to +0x57F  (256 bytes)  — Usage Parameters   -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <structure name="UP_Record" id="900" encoding="UTF-8" endian="little" signed="no" length="256">

      <string name="RecordTag" id="901" type="fixed-length" length="2" encoding="ASCII">
        <description>Record tag: "UP"</description>
      </string>
      <number name="RecordVersion" id="902" type="integer" length="2" endian="little" signed="no" display="hex">
        <description>Record version (observed: 0x0100)</description>
      </number>
      <binary name="Flags1" id="903" length="2">
        <description>Flags (observed: 01 00)</description>
      </binary>
      <binary name="Flags2" id="904" length="2">
        <description>Flags (observed: 00 00)</description>
      </binary>
      <binary name="DateTime_0x08" id="905" length="6">
        <description>Date/time: year+1900, month, day, hour, minute, second (same 6-byte encoding as UH)</description>
      </binary>
      <binary name="Padding_0x0E" id="906" length="2">
        <description>Padding (zeros)</description>
      </binary>
      <number name="Duration_secs" id="907" type="integer" length="4" endian="little" signed="no" display="decimal">
        <description>Duration / counter (seconds)</description>
      </number>
      <number name="BlockRef" id="908" type="integer" length="4" endian="little" signed="no" display="decimal">
        <description>Block reference / sequence number</description>
      </number>
      <binary name="ExtendedParameters" id="909" length="230">
        <description>Extended parameters (zeros, 0x18–0xFD)</description>
      </binary>
      <number name="Checksum" id="910" type="integer" length="2" endian="little" signed="no" display="hex">
        <description>Block checksum (16-bit; observed: 0x0285)</description>
      </number>

    </structure><!-- UP_Record -->

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!--  INFO RECORD  +0x580 to +0x67F  (256 bytes)                     -->
    <!--  Device / Firmware Info                                          -->
    <!--  NOTE: block 0 (day 0) contains zeros / no cellular data.        -->
    <!--  Blocks 1–N contain valid strings.                               -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <structure name="Info_Record" id="1000" encoding="UTF-8" endian="little" signed="no" length="256">

      <string name="AppVersion" id="1001" type="fixed-length" length="16" encoding="ASCII">
        <description>Application (cloud/app) version (e.g. "1.22.08\0")</description>
      </string>
      <string name="CellularModuleID" id="1002" type="fixed-length" length="16" encoding="ASCII">
        <description>Cellular module ID (e.g. "G3625633781\0")</description>
      </string>
      <binary name="Unknown_0x20" id="1003" length="4">
        <description>Unknown (0xFFFFFFFF in some blocks)</description>
      </binary>
      <binary name="Padding_0x24" id="1004" length="12">
        <description>Padding (zeros)</description>
      </binary>
      <string name="ICCID" id="1005" type="fixed-length" length="24" encoding="ASCII">
        <description>ICCID — SIM card identifier (e.g. "89011702324037319288")</description>
      </string>
      <binary name="Padding_0x48" id="1006" length="8">
        <description>Padding (zeros)</description>
      </binary>
      <string name="FirmwareVersion_App" id="1007" type="fixed-length" length="20" encoding="ASCII">
        <description>Application firmware version (e.g. "G3-2.11.02.33\0")</description>
      </string>
      <binary name="Padding_0x64" id="1008" length="154">
        <description>Padding to end (zeros, 0x64–0xFD)</description>
      </binary>
      <number name="Checksum" id="1009" type="integer" length="2" endian="little" signed="no" display="hex">
        <description>Block checksum (16-bit; 0x0000 in some blocks)</description>
      </number>

    </structure><!-- Info_Record -->

  </grammar>
</ufwb>
